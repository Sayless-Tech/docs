        "global": {
          "anchors": [
            {
              "anchor": "Home",
              "icon": "house",
              "href": "/"
            },
            {
              "anchor": "Changelog",
              "icon": "scroll-text",
              "href": "https://www.mintlify.com/docs/changelog"
            },
            {
              "anchor": "Help",
              "icon": "life-buoy",
              "href": "https://www.mintlify.com/docs/contact-support"
            }
          ]
        },
        "directory": "card"
      }
    ]
  },

  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
