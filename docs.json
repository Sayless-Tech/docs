                  "preferences",
                  "notifications",
                  "security-and-access"
                ]
              },
              {
                "group": "Sidebar",
                "pages": [
                  "conversations",
                  "broadcasts",
                  "records",
                  "reports"
                ]
              },
              {
                "group": "Inbox",
                "pages": []
              },
              {
                "group": "Tickets",
                "pages": [
                  "create-ticket",
                  "edit-ticket"
                ]
              },
              {
                "group": "Broadcasts",
                "pages": []
              },
              {
                "group": "Companies",
                "pages": []
              },
              {
                "group": "Contacts",
                "pages": []
              },
              {
                "group": "Metrics",
                "pages": []
              },
              {
                "group": "Reports",
                "pages": []
              },
              {
                "group": "Integrations",
                "pages": []
              },
              {
                "group": "Admin",
                "pages": []
              }
            ]
          },
          {
            "tab": "API Reference",
            "openapi": "openapi.json"
          }
