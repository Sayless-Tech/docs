{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Sayless",
  "description": "Product guides and public API docs for Sayless — post-sales customer work in one workspace.",
  "colors": {
    "primary": "#FF5601",
    "light": "#FF8B62",
    "dark": "#D44600"
  },
  "favicon": {
    "light": "/images/favicon.svg",
    "dark": "/images/favicon.svg"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guide",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "getting-started/quickstart",
              "getting-started/key-concepts",
              "getting-started/editor"
            ]
          },
          {
            "group": "Account",
            "pages": [
              "account/profile",
              "account/preferences",
              "account/notifications",
              "account/security-and-access"
            ]
          },
          {
            "group": "Sidebar",
            "pages": [
              "sidebar/conversations",
              "sidebar/broadcasts",
              "sidebar/records",
              "sidebar/reports"
            ]
          },
          {
            "group": "Inbox",
            "pages": [
              "inbox/reply-conversation",
              "inbox/assign-conversation",
              "inbox/properties"
            ]
          },
          {
            "group": "Tickets",
            "pages": [
              "ticket/create-ticket",
              "ticket/edit-ticket",
              "ticket/properties",
              "ticket/assign-ticket",
              "ticket/comments"
            ]
          },
          {
            "group": "Broadcasts",
            "pages": [
              "broadcasts/create-broadcast",
              "broadcasts/edit-broadcast",
              "broadcasts/properties"
            ]
          },
          {
            "group": "Companies",
            "pages": [
              "companies/companies",
              "companies/files-and-notes",
              "companies/pricing",
              "companies/properties"
            ]
          },
          {
            "group": "Contacts",
            "pages": ["contacts", "contacts/properties"]
          },
          {
            "group": "Metrics",
            "pages": [
              "metrics",
              "metrics/metric-events",
              "metrics/metric-charts",
              "metrics/properties"
            ]
          },
          {
            "group": "Reports",
            "pages": ["reports", "reports/dashboards"]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/email",
              "integrations/slack",
              "integrations/microsoft-teams",
              "integrations/whatsapp",
              "integrations/telegram",
              "integrations/jira",
              "integrations/linear"
            ]
          },
          {
            "group": "Admin",
            "pages": [
              "admin/workspaces",
              "admin/login-methods",
              "admin/members",
              "admin/api-and-webhooks",
              "admin/billing-and-plans"
            ]
          }
        ]
      },
      {
        "tab": "Developers",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "developers/overview",
              "developers/quickstart",
              "developers/authentication",
              "developers/api/overview"
            ]
          },
          {
            "group": "API",
            "pages": [
              "developers/api/tickets",
              "developers/api/conversations",
              "developers/api/messages",
              "developers/api/companies",
              "developers/api/contacts",
              "developers/api/notes",
              "developers/api/documents",
              "developers/api/teams",
              "developers/api/attachments",
              "developers/api/webhookSubscriptions"
            ]
          },
          {
            "group": "Webhooks & platform",
            "pages": [
              "developers/webhooks",
              "developers/pagination",
              "developers/errors",
              "developers/rate-limits",
              "developers/stability-and-versioning",
              "developers/changelog"
            ]
          },
          {
            "group": "SDK",
            "pages": [
              "developers/sdk/install",
              "developers/sdk/client",
              "developers/sdk/examples"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi.json"
      },
      {
        "tab": "Changelog",
        "href": "https://joinsayless.com/changelog"
      }
    ],
    "directory": "card"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://joinsayless.com"
  },
  "navbar": {
    "links": [
      {
        "label": "Marketing",
        "href": "https://joinsayless.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open app",
      "href": "https://app.joinsayless.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/joinsayless",
      "linkedin": "https://www.linkedin.com/company/joinsayless"
    }
  },
  "interaction": {
    "drilldown": false
  },
  "metadata": {
    "timestamp": false
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#FCFAFA",
      "dark": "#1F1F20"
    }
  },
  "fonts": {
    "heading": {
      "family": "Instrument Sans",
      "weight": 500
    },
    "body": {
      "family": "Instrument Sans",
      "weight": 400
    }
  },
  "thumbnails": {
    "appearance": "light"
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/getting-started/quickstart",
      "permanent": true
    },
    {
      "source": "/changelog",
      "destination": "https://joinsayless.com/changelog",
      "permanent": true
    },
    {
      "source": "/developers",
      "destination": "/developers/overview",
      "permanent": true
    }
  ]
}
